      "type": "double"
    },
    {
      "name": "origin",
      "type": ["null", "long"],
      "default": null
    },
    {
      "name": "destiny",
      "type": ["null", "long"],
      "default": null
    },
    {
      "name": "date",
      "type": "string"
    }
  ]
}